<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive Laravel files and directories
    RewriteRule ^(\.env|\.git|composer\.json|composer\.lock|artisan|phpunit\.xml|package\.json|package-lock\.json|vite\.config\.js) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs)(/|$) - [F,L,NC]

    # Keep InfinityFree Free SSL ACME challenge path accessible
    RewriteCond %{REQUEST_URI} !^/\.well-known/

    # Rewrite all remaining requests into Laravel's public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
